# URL publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=https://cryptshop.vercel.app

# Notifications de commandes (Telegram)
# 1. Parlez à @BotFather sur Telegram, envoyez /newbot, récupérez le token.
# 2. Envoyez un message à votre bot, puis ouvrez :
#    https://api.telegram.org/bot<VOTRE_TOKEN>/getUpdates
#    et récupérez "chat":{"id":...}
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optionnel : notification Discord en plus
DISCORD_WEBHOOK_URL=

# Adresses de réception des paiements (à remplir avant la mise en ligne)
BTC_ADDRESS=
ETH_ADDRESS=
SOL_ADDRESS=

# Optionnel : historique des commandes (Upstash Redis - plan gratuit)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Adresse e-mail affichée sur le site
NEXT_PUBLIC_CONTACT_EMAIL=contact@cryptshop.store
